<script>
(function () {
  var REGISTERED = 6;
  var CAPACITY = 50;
  var left = Math.max(0, CAPACITY - REGISTERED);
  var seatsEl = document.getElementById('seatsPill');
  if (seatsEl) seatsEl.textContent = REGISTERED + ' doctors registered · ' + left + ' seats remaining';
  var stickyMeta = document.getElementById('stickyMeta');

  var earlyBirdEnd = new Date('2026-09-16T23:59:59+05:30').getTime();
  var eventStart = new Date('2026-09-21T09:00:00+05:30').getTime();
  var bar = document.getElementById('countdownBar');

  function pad(n) { return n < 10 ? '0' + n : String(n); }

  function tick() {
    var now = Date.now();
    var target, label, warn;
    if (now <= earlyBirdEnd) {
      target = earlyBirdEnd;
      label = 'Early bird ends in';
      warn = true;
    } else {
      target = eventStart;
      label = 'Event starts in';
      warn = false;
    }
    var diff = Math.max(0, target - now);
    var d = Math.floor(diff / 86400000);
    var h = Math.floor((diff % 86400000) / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    var timeStr = d + 'd ' + pad(h) + 'h ' + pad(m) + 'm ' + pad(s) + 's';
    if (bar) {
      bar.innerHTML = (warn ? '<span class="warn">' + label + ' ' + timeStr + '</span>' : '<span>' + label + ' ' + timeStr + '</span>') +
        ' · <span>' + left + ' seats left</span> · ₹' + (now <= earlyBirdEnd ? '2,500' : '3,000');
    }
    if (stickyMeta) {
      stickyMeta.textContent = left + ' seats left · ' + (now <= earlyBirdEnd ? 'Early bird till 16 Sept' : 'Fee ₹3,000');
    }
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

